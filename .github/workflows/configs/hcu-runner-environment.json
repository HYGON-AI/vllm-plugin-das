{
  "schema_version": 1,
  "python": {
    "match": "exact",
    "versions": ["3.10.12", "3.12.12"]
  },
  "torch_hip": {
    "match": "prefix",
    "versions": ["6.3.", "7.2."]
  },
  "rocm": {
    "environment": "ROCM_PATH",
    "version_file": ".info/rocm_version",
    "match": "release_line",
    "versions": ["26.04", "26.10"]
  },
  "distributions": {
    "torch": {
      "match": "prefix",
      "version": "2.11.0+"
    },
    "vllm": {
      "match": "release",
      "version": "0.28.1"
    },
    "vllm-hcu": {
      "match": "release",
      "version": "0.28.1"
    },
    "aiter": {
      "match": "prefix",
      "version": "0.1."
    },
    "pytest": {
      "match": "exact",
      "version": "9.1.1"
    }
  }
}
