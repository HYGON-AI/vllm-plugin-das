{
  "schema_version": 1,
  "python": "3.10.12",
  "torch_hip": {
    "match": "prefix",
    "version": "6.3."
  },
  "rocm": {
    "environment": "ROCM_PATH",
    "version_file": ".info/rocm_version",
    "match": "release_line",
    "version": "26.04"
  },
  "distributions": {
    "torch": {
      "match": "prefix",
      "version": "2.11.0+"
    },
    "vllm": {
      "match": "release",
      "version": "0.28.1"
    },
    "vllm-hcu": {
      "match": "release",
      "version": "0.28.1"
    },
    "aiter": {
      "match": "prefix",
      "version": "0.1."
    },
    "pytest": {
      "match": "exact",
      "version": "9.1.1"
    }
  }
}
