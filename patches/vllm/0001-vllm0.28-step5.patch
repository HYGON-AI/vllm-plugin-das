+        k_input = summary.view(torch.float8_e4m3fn)
+    elif summary.dtype == torch.float8_e4m3fn:
+        k_input = summary
+    else:
+        raise ValueError(
+            "paged WGMMA logits requires pre-quantized FP8 summary "
+            "(float8_e4m3fn or uint8 bits)"
+        )
