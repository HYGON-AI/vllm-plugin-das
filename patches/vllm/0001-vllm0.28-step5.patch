+def silu(a: float | Float32) -> Float32:
+    """silu(a) = a * sigmoid(a) = (0.5 * a) * tanh(0.5 * a) + (0.5 * a)."""
+    a_half = Float32(0.5) * Float32(a)
+    return a_half * cute.math.tanh(a_half) + a_half
