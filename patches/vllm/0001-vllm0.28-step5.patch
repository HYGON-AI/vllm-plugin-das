+from .mtp_state_machine import Step5KernelPlan
+from .sparse_summary_cache import (
+    _step5_sparse_csa_compact_clear_completed_kernel,
+    _step5_sparse_csa_compact_clear_scratch_kernel,
+)
+
+_MTP_ACTION_NONE = 0
+_MTP_ACTION_CLEAR = 1
+_MTP_ACTION_INSTALL = 2
+_MTP_ACTION_INSTALL_PRE = 3
+_MTP_ACTION_KEEP = 4
+# Compatibility for tests and callers written against the pre-install name.
+_MTP_ACTION_RESTORE = _MTP_ACTION_INSTALL
