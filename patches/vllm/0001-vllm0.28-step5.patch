+        ip=ip,
+    )
+    vec_i128 = vector.bitcast(T.vector(1, T.i(128)), vec_i64)
+    packed = vector.extract(vec_i128, dynamic_position=[], static_position=[0], loc=loc, ip=ip)
+    return Int128(packed)
