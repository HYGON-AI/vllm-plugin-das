+_HEAD_DIM = 64
+_THREADS_PER_WARP = 32
+_DIMS_PER_LANE = 2
+_WARPS_PER_BLOCK = 8
+_THREADS_PER_BLOCK = _THREADS_PER_WARP * _WARPS_PER_BLOCK
