+@dsl_user_op
+def tma_cache_hint_evict_last(*, loc=None, ip=None) -> cutlass.Int64:
+    # TMA traits expect an Int64 backed by an MLIR value,
+    # not a static Python integer; otherwise atom_set_value sees a host int.
+    return cutlass.Int64(cutlass.Int64(0x14F0000000000000).ir_value(loc=loc, ip=ip))
