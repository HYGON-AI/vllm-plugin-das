+        gating_output,
+        router_bias,
+        topk,
+        renormalize=renormalize,
+        routed_scaling_factor=routed_scaling_factor,
+        nan_row_i_out=nan_row_i_out,
+        indices_dtype=indices_dtype,
+    )
