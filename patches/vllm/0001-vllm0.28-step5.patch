+            mCausalLimits,
+            mExactMaskBits,
+            Int32(total_q),
+            Int32(q_global_offset),
+        ).launch(
+            grid=[total_groups, 1, 1],
+            block=[_UNION_COMPACT_THREADS, 1, 1],
+            stream=stream,
+        )
+
+    return _launch_grouped_union_logical_bitset_compact_kernel
+
+
+def _make_union_compile_placeholders(
+    topk_windows: int,
+    bit_words: int,
+    max_union_windows: int,
+    q_group: int,
+    device: torch.device,
+) -> tuple[torch.Tensor, ...]:
+    return (
