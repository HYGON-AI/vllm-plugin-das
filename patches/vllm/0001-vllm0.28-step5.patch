+        packed_regions + row * (topk + 1) + history_count,
+        current_packed,
+    )
+    tl.store(
+        region_phys_indices + row * (topk + 1) + history_count,
+        current_physical_page * REGIONS_PER_KERNEL_PAGE + current_page_slot,
+    )
