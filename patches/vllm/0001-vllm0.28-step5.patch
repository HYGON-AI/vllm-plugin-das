+        or tuple(row_req_idx.shape) != (query_rows,)
+        or not row_req_idx.is_contiguous()
+    ):
+        raise ValueError(
+            f"row_req_idx must be contiguous int32 [{query_rows}], got "
+            f"{tuple(row_req_idx.shape)} {row_req_idx.dtype}"
+        )
