+def _valid_variable_split_max(value: int) -> int:
+    value = int(value)
+    if value not in (1, 2, 4, 16):
+        raise ValueError(
+            f"variable_split_max must be one of {{1, 2, 4, 16}}, got {value}"
+        )
+    return value
