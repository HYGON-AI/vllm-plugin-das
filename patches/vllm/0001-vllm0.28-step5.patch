+        row_starts.dtype != torch.int32
+        or row_starts.dim() != 1
+        or tuple(row_starts.shape) != (query_rows,)
+        or not row_starts.is_contiguous()
+    ):
+        raise ValueError(
+            f"row_starts must be contiguous int32 [{query_rows}], got "
+            f"{tuple(row_starts.shape)} {row_starts.dtype}"
