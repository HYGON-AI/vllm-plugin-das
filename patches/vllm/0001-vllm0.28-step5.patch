+            region_indices = self._get_dsa_tensor_buffer_at_least(
+                "prefill_region_indices_workspace",
+                (tile_rows, topk + 1),
+                device=query.device,
+                dtype=torch.int32,
+            )
+            block_k = 1 << (topk - 1).bit_length()
+            _step5_prefill_tile_pack_kernel[(tile_rows,)](
+                raw_topk,
+                row_owners_view,
+                tile_query_start_loc_view,
+                tile_seq_lens_view,
+                kernel_block_table,
+                region_counts,
+                packed_regions,
+                region_phys_indices,
+                region_indices,
+                topk,
