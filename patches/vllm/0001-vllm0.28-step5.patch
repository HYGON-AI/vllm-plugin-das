+    target = (
+        flat_block_table
+        + tokens[:, None] * flat_block_table_stride0
+        + page_id[None, :] * flat_block_table_stride1
+    )
+    values = tl.load(source, mask=page_mask, other=-1)
+    tl.store(
+        target,
+        values[None, :],
+        mask=token_mask[:, None] & page_mask[None, :],
+    )
