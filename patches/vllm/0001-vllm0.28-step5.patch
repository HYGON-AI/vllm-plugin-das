+    if tuple(row_ends.shape) != (int(index_q.shape[0]), q_len):
+        raise ValueError(f"row_ends must be [B,Q], got {tuple(row_ends.shape)}")
+    _batch_decode_weighted_relu_logits_sum_paged_sm90_steptron_gqa_out(
+        index_q,
+        weights,
+        summary,
+        block_table,
+        row_req_idx,
+        row_table_idx,
+        row_starts,
+        row_ends.reshape(-1),
+        q_runtime,
+        kernel_weights,
+        out,
+        valid_requests,
+        valid_tokens,
+    )
+    return out
