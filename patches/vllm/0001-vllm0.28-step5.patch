+            (
+                int(self.sm_count)
+                if use_dynamic_split_kernel
+                else None
+            ),
+            *tensor_signatures,
+            int(q_align),
+            int(k_align),
+            int(v_align),
+            int(packed_align),
+            int(counts_align),
+            int(seq_lens_align),
+            int(out_align),
+            None if lse is None else int(lse_align),
+            float(softmax_scale),
+            utils.device_cache_key(q.device),
+        )
+
+        compiled_args = (
+            q,
+            k_cache,
+            v_cache,
+            packed,
+            counts,
+            seq_lens,
+            query_start_loc,
+            valid_rows,
+            out,
+            lse,
+        )
