+        with torch.profiler.record_function(
+            "step5_dsa.decode.mtp_union_exact_mask_merge"
+        ):
+            merge_mtp_union_exact_mask_nat_lse_states_sm90_gqa(
+                partial_out,
+                partial_lse,
