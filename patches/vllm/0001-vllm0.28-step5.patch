+def fused_qknorm_rope_forward_impl(
+    qkv: torch.Tensor,
+    qnorm_weight: torch.Tensor,
+    knorm_weight: torch.Tensor,
+    cos: torch.Tensor,
+    sin: torch.Tensor,
+    pos_id: torch.Tensor,
+    head_dim: int,
