+                work_q_global,
+                work_q_local,
+                work_q_len,
+                union_counts,
+                union_phys,
+                causal_limits,
+                union_logical,
+                exact_mask_bits,
+            )
+        return out_req_idx, work_q_global, work_q_local, work_q_len, union_counts, union_phys, causal_limits
+
+    bit_words = (int(num_region_bins) + 31) // 32
