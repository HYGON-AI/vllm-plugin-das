+
+@cached_compile_function
+def _get_compiled_union_fill_kernel_for_shape(
+    q_group: int,
+    topk_windows: int,
+    topk_width: int,
+    num_region_bins: int,
+    bit_words: int,
+    bit_words_width: int,
