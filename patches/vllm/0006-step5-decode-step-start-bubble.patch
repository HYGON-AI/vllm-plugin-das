     # stays valid for every replay the graph serves.
     max_query_len: int | None = None
 
+    # Exact host copies of seq_lens / num_computed_tokens ([num_reqs_padded],
+    # padded rows zero) and of the gathered block tables, when the runner keeps
+    # a host mirror. They let host-scheduling attention builders skip the
+    # seq_lens D2H, which waits for the whole previous step (drafter included).
+    seq_lens_cpu: torch.Tensor | None = None
+    num_computed_tokens_cpu: torch.Tensor | None = None
+    block_tables_np: tuple[np.ndarray, ...] | None = None
+
     @classmethod
     def make_dummy(
         cls,
