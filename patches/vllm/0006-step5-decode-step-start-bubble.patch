diff --git a/v1/worker/gpu/block_table.py b/v1/worker/gpu/block_table.py
index c01895e..226e7a4 100644
--- a/v1/worker/gpu/block_table.py
+++ b/v1/worker/gpu/block_table.py
@@ -2,6 +2,7 @@
 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
 from collections.abc import Iterable
 
+import numpy as np
 import torch
 
 from vllm.triton_utils import tl, triton
@@ -57,6 +58,9 @@ class BlockTables:
                 (self.max_num_reqs, max_num_blocks), dtype=torch.int32, device=device
             )
             self.block_tables.append(block_table)
+        # Optional host mirror of the block tables, enabled by the runner when
+        # an attention backend schedules on the host (see gather_block_tables_np).
+        self.block_tables_np: list[np.ndarray] | None = None
 
         self.num_blocks = UvaBackedTensor(
             (self.num_kv_cache_groups, self.max_num_reqs),
@@ -130,8 +134,33 @@ class BlockTables:
                     f"row capacity ({end} > {row_capacity})"
                 )
             self.block_tables[i].stage_write(req_index, start, block_ids)
+            if self.block_tables_np is not None:
+                self.block_tables_np[i][req_index, start:end] = block_ids
             self.num_blocks.np[i, req_index] = end
 
+    def enable_host_mirror(self) -> None:
+        if self.block_tables_np is None:
+            self.block_tables_np = [
+                np.zeros(tuple(b.gpu.shape), dtype=np.int32) for b in self.block_tables
+            ]
+
+    def gather_block_tables_np(
+        self, idx_mapping_np: np.ndarray, num_reqs_padded: int
+    ) -> tuple[np.ndarray, ...]:
+        """Host counterpart of gather_block_tables: same rows, padded rows zero.
+
+        Must be called after this step's append_block_ids (as the device gather
+        is), and the result is the data the device tables hold for this step.
+        """
+        assert self.block_tables_np is not None
+        num_reqs = idx_mapping_np.shape[0]
+        out = []
+        for table in self.block_tables_np:
+            gathered = np.zeros((num_reqs_padded, table.shape[1]), dtype=table.dtype)
+            np.take(table, idx_mapping_np, axis=0, out=gathered[:num_reqs])
+            out.append(gathered)
+        return tuple(out)
+
     def apply_staged_writes(self) -> None:
         if self.num_kv_cache_groups == 0:
             return
