 from collections.abc import Sequence
@@ -63,6 +64,12 @@ from .rebalance_execute import (
 
 logger = init_logger(__name__)
 
+# Record whether an expert received any token in a step instead of how many.
+# Bandwidth-bound grouped-GEMM backends pay per touched expert, not per token,
+# so balancing touched counts balances their per-rank MoE time.
+_EPLB_TOUCHED_LOAD = os.environ.get("VLLM_EPLB_TOUCHED_LOAD", "0") == "1"
+_EPLB_DUMP_PATH = os.environ.get("VLLM_EPLB_DUMP_PATH", "")
+
 
 def _compute_eplb_load_stats(
     num_tokens_per_rank: torch.Tensor,
@@ -617,9 +624,12 @@ class EplbState:
             should_record = self._should_record_current_step(log_stats=log_stats)
             for eplb_model_state in self.model_states.values():
                 if should_record:
+                    load_pass = eplb_model_state.expert_load_pass
+                    if _EPLB_TOUCHED_LOAD:
+                        load_pass = load_pass > 0
                     eplb_model_state.expert_load_window[
                         self.expert_load_window_step
-                    ].copy_(eplb_model_state.expert_load_pass)
+                    ].copy_(load_pass)
                     eplb_model_state.expert_load_pass.zero_()
 
             if should_record:
@@ -706,9 +716,15 @@ class EplbState:
         Must be called after :meth:`model.set_eplb_state` so that each
         layer's ``eplb_state`` is already populated.
         """
+        # Some models (e.g. Step5) list the MoE block, which wraps the runner
+        # holding ``eplb_state`` in ``.experts``.
+        layers = [
+            layer if hasattr(layer, "eplb_state") else getattr(layer, "experts", layer)
+            for layer in model.moe_layers
+        ]
         layer_states = [
             layer.eplb_state
-            for layer in model.moe_layers
+            for layer in layers
             if hasattr(layer, "eplb_state")
             and isinstance(layer.eplb_state, EplbLayerState)
         ]
@@ -862,13 +878,18 @@ class EplbState:
                             dim=1,
                             index=mapping,
                         )
+                        # Layers synchronize at the EP combine, so each layer
+                        # costs its slowest rank: compare per-layer maxima
+                        # (the inverse of the logged balancedness) rather than
+                        # loads summed over layers, which average out.
                         loads_per_rank = loads_per_replica.reshape(
                             logical_loads.shape[0], ep_size, -1
-                        ).sum(dim=(0, 2))
-                        mean_load = loads_per_rank.mean()
+                        ).sum(dim=2)
+                        mean_load = loads_per_rank.mean(dim=1).sum()
                         if mean_load == 0:
                             return 1.0
-                        return (loads_per_rank.max() / mean_load).item()
+                        max_load = loads_per_rank.max(dim=1).values.sum()
+                        return (max_load / mean_load).item()
 
                     current_imbalance = rank_load_imbalance(
                         eplb_model_state.physical_to_logical_map
@@ -887,6 +908,24 @@ class EplbState:
                             current_imbalance,
                             proposed_imbalance,
                         )
+                    elif is_main_rank:
+                        logger.info(
+                            "[EPLB] Rearrange: imbalance %.4f -> %.4f",
+                            current_imbalance,
+                            proposed_imbalance,
