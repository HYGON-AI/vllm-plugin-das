@@ -588,7 +588,12 @@ class FusedMoEBlock(nn.Module):
             intermediate_size=config.share_expert_dim,
             hidden_act="silu",
             reduce_results=reduce_results,
-            quant_config=quant_config,
+            # The shared expert is bf16 in both checkpoints. Do not rely on the
+            # ignore list: hf_to_vllm_mapper renames it to ".moe.share_expert.",
+            # which the channel checkpoint's regex ("layers.N.share_expert.")
+            # does not match, so it would be built as fp8 and the bf16 weights
+            # cast into it with no scale.
+            quant_config=None,
             prefix=f"{prefix}.share_expert",
         )
         custom_routing_function = functools.partial(
diff --git a/transformers_utils/configs/step5.py b/transformers_utils/configs/step5.py
index deefaa1..d4a911f 100644
--- a/transformers_utils/configs/step5.py
+++ b/transformers_utils/configs/step5.py
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: Apache-2.0
 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import os
 from typing import Any
 
 from transformers.configuration_utils import PretrainedConfig
@@ -206,6 +207,37 @@ class Step5Config(PretrainedConfig):
             tie_word_embeddings=tie_word_embeddings,
             **kwargs,
         )
+        self._register_dsa_splitting_op()
+
+    def _register_dsa_splitting_op(self) -> None:
+        """Make the DSA indexer op a compilation splitting op, process-wide.
+
+        The indexer (model_executor/layers/step4_dsa.py) is a custom op with a
+        Python body. Under piecewise cudagraphs an indexer that is not a
+        splitting op is captured and replays the warm-up region plan forever.
+        vLLM's in-tree indexer sits in ``CompilationConfig._attention_ops``;
+        this one is out of tree, so it adds itself here -- the config is parsed
+        in ``ModelConfig.__init__``, before ``VllmConfig.__post_init__``
+        resolves the splitting-op list. step4_dsa's ``_require_splitting_op``
+        fails loudly if this registration is missing.
+        """
+        sparse_config = getattr(self, "sparse_config", None) or {}
+        if isinstance(sparse_config, dict):
+            enabled = sparse_config.get("enabled", False)
+        else:
+            enabled = getattr(sparse_config, "enabled", False)
+        # Matches models/step5_text.py's DISABLE_DSA: the dense fallback has no
+        # indexer op in the graph to split on.
+        if not enabled or os.environ.get("VLLM_STEP5_DISABLE_DSA", "0") == "1":
+            return
+        # Deferred: vllm.config imports this module transitively.
+        from vllm.config.compilation import CompilationConfig
+
+        # Literal, not imported from step4_dsa (that would pull in torch and
+        # Triton during config resolution).
+        op = "vllm::step4_dsa_index"
+        if op not in CompilationConfig._attention_ops:
+            CompilationConfig._attention_ops.append(op)
 
 
 class Step5VLConfig(PretrainedConfig):
