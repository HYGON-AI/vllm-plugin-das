index 493b9c1..ee0e2f9 100644
--- a/model_executor/layers/step4_dsa.py
+++ b/model_executor/layers/step4_dsa.py
@@ -60,8 +60,10 @@ from vllm.forward_context import get_forward_context
 from vllm.logger import init_logger
 from vllm.model_executor.layers.step4_dsa_kernels import (
     REGION_BLOCK_SIZE,
