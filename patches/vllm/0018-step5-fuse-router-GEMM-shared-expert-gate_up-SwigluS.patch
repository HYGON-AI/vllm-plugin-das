@@ -144,6 +144,13 @@ FUSE_QKVG = os.environ.get("VLLM_HCU_STEP5_FUSE_QKVG", "1") == "1"
 # accumulation order, since bf16 x bf16 products are exact in fp32.
 BF16_ROUTER = os.environ.get("VLLM_HCU_STEP5_BF16_ROUTER", "1") == "1"
 
