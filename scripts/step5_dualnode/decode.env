export VLLM_SHARED_EXPERTS_STREAM_TOKEN_THRESHOLD=0
export VLLM_HCU_EP_FUSED_COMBINE=0
export VLLM_HCU_DP_CUSTOM_AG=0
export VLLM_HCU_STEP5_FP8_DENSE=1
export VLLM_HCU_STEP5_FP8_BF16_MOE=1
export VLLM_HCU_STEP5_SWA_FUSED_QK=1
export VLLM_HCU_STEP5_FUSED_GATE=1
export VLLM_HCU_TRITON_TOKEN_FP8_QUANT=1
export VLLM_HCU_STEP5_QKV_INDEXER=1
export VLLM_HCU_STEP5_DSA_FUSED_QK=1
export VLLM_HCU_STEP5_DECODE_PRODUCERS=1
export VLLM_ENGINE_READY_TIMEOUT_S=3600
export VLLM_HCU_PIN_MEMORY=1
export HIP_FORCE_DEV_KERNARG=1
export HCU_STEP5_DP_PIPE_OUTPUT_POOL=0
export ROCBLAS_DEVICE_MEMORY_SIZE=0
unset ROCBLAS_STREAM_ORDER_ALLOC
unset VLLM_STEP5_EXPERT_PLACEMENT DEEP_EP_NORMAL_MNVL ROCSHMEM_IPC_MNVL ROCSHMEM_IPC_MNVL_NPES
export ROCSHMEM_BACKEND=gda
export ROCSHMEM_GDA_PROVIDER=mlx5
export ROCSHMEM_GDA_RAIL_ONLY=1
export ROCSHMEM_DISABLE_IPC=0
export ROCSHMEM_DISABLE_MIXED_IPC=0
export ROCSHMEM_BOOTSTRAP_SOCKET_IFNAME=ens30np0
export ROCSHMEM_IB_GID_INDEX=3
export ROCSHMEM_USE_IB_HCA=mlx5_0
export DUSHMEM_ENABLE_PE_MAPPING=1
export DUSHMEM_HCA_LIST=mlx5_0:1
export DEEP_EP_DEVICE_TO_HCA_MAPPING=0:mlx5_0:1,1:mlx5_1:1,2:mlx5_2:1,3:mlx5_3:1,4:mlx5_4:1,5:mlx5_5:1,6:mlx5_6:1,7:mlx5_7:1
export VLLM_HCU_DEEPEP_AUTO_SHARED_WEIGHTS=1
export DEEPEP_ENABLE_LL_LAYERED_OPT=1
export DEEPEP_ENABLE_LL_LAYERED_DEVELOP=0
export GPU_MAX_HW_QUEUES=16
export VLLM_DISABLE_SHARED_EXPERTS_STREAM=1
export STEP5_COMPILATION_CONFIG='{"mode":3,"backend":"eager","use_inductor_graph_partition":false,"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["none","+swiglustep_and_mul","+GemmaRMSNorm"],"compile_sizes":[16,64]}'
export VLLM_HCU_USE_CUSTOM_GEMMA_RMS_NORM=1
export VLLM_ROCM_USE_AITER_MOE=0
export VLLM_USE_DEEP_GEMM=1
export VLLM_MOE_USE_DEEP_GEMM=1
export VLLM_DISABLE_COMPILE_CACHE=1
export VLLM_USE_AOT_COMPILE=0
unset VLLM_FORCE_AOT_LOAD VLLM_PLUGINS CUDA_VISIBLE_DEVICES ROCR_VISIBLE_DEVICES
