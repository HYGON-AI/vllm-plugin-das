set -euo pipefail
: "${NODE_RANK:?Set NODE_RANK}"
case "$NODE_RANK" in 0|1) ;; *) exit 2;; esac
for step5_old_name in $(compgen -v); do
  case "$step5_old_name" in
    HCU_STEP5_*|VLLM_STEP5_*|VLLM_STEP4_*|HCU_DP_MOE_*|HCU_DBO_*|HCU_STATIC_EPLB_*) unset "$step5_old_name" ;;
  esac
done
unset step5_old_name
unset PYTORCH_ALLOC_CONF PYTORCH_CUDA_ALLOC_CONF PYTORCH_HIP_ALLOC_CONF
unset PYTHONPATH LD_PRELOAD LD_AUDIT ROCBLAS_TENSILE_LIBPATH HIPBLASLT_TUNING_OVERRIDE_FILE
unset NCCL_TOPO_FILE NCCL_IB_DISABLE NCCL_MIN_NCHANNELS
unset DEEP_EP_NORMAL_MNVL VLLM_DEEPEP_BUFFER_SIZE_MB HCU_STEP5_DEEPEP_RUNTIME_CONFIG
unset VLLM_USE_DEEP_GEMM VLLM_MOE_USE_DEEP_GEMM HCU_MTP_PREFILL_TAIL
unset HCU_STEP5_TUNING_CONFIG STEP5_EXPERT_STATIC_MAP
unset XUWQ_CAPACITY_BLOCK_RUN_ID
export STEP5_PREFILL_GPU_MEMORY_UTILIZATION=0
export STEP5_DECODE_GPU_MEMORY_UTILIZATION=0.5
unset PYTORCH_CUDA_ALLOC_CONF PYTORCH_HIP_ALLOC_CONF
unset PYTORCH_ALLOC_CONF PYTORCH_CUDA_ALLOC_CONF PYTORCH_HIP_ALLOC_CONF
export STEP5_MAX_MODEL_LEN=70000
export STEP5_MAX_NUM_BATCHED_TOKENS=512
export STEP5_TOKENIZER="$TOKENIZER_DIR"
export STEP5_PORT=18118
export STEP5_RPC_PORT=18292
if [[ -z "${STEP5_SPECULATIVE_CONFIG:-}" ]]; then
  export STEP5_SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":3,"rejection_sample_method":"synthetic","synthetic_acceptance_rates":[0.838992,0.598322,0.362686],"use_local_argmax_reduction":true}'
fi
export HSA_FORCE_FINE_GRAIN_PCIE=1
export OMP_NUM_THREADS=1
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export NCCL_DEBUG=INFO
unset NCCL_TOPO_FILE NCCL_IB_DISABLE
export NCCL_CROSS_NIC=0
export NCCL_IB_HCA=mlx5_0:1,mlx5_1:1,mlx5_2:1,mlx5_3:1,mlx5_4:1,mlx5_5:1,mlx5_6:1,mlx5_7:1
export STEP5_GPU_ORDER_S7=0,1,2,3,4,5,6,7
export STEP5_GPU_ORDER_S9=0,1,2,3,4,6,7,5
export HCU_SHARED_EXPERTS_STREAM_MIN_TOKENS=0
export HCU_DP_MOE_PIPE_MIN_TOKENS=0
export HCU_DBO_MIN_TOKENS=0
export HCU_EP_DIRECT_SUM=0
export HCU_STEP5_EXPERT_GRID=0
export HCU_STEP5_FUSED_ROUTER_STREAM=0
export HCU_STEP5_BOUNDED_EP_WORKSPACE=1
export EP_FUSED_MOE_CHUNK=16384
export VLLM_STEP4_DSA_GRAPH_REGIONS=8736
export HCU_STEP5_DENSE_TUNING=0
export HCU_STEP5_PREFILL_ASM_G1=0
export HCU_STEP5_PREFILL_G2=0
export HCU_STEP5_SPARSE_RS=0
export VLLM_HCU_SHARED_EXPERTS_EARLY_LAUNCH=0
export HCU_STEP5_ROUTER_SHARED_MAX_M=64
export HCU_STEP5_CONTEXT_GRAPH_REGIONS=8736
export HCU_DP_MOE_PIPE_UNIFORM=0
export HCU_STEP5_DP_FABRIC=0
export VLLM_HCU_DP_PACKED_AG=0
export SPT_NOENV=1
export VLLM_HCU_SHARED_EXPERTS_STREAM_FORCE=0
export NCCL_MAX_NCHANNELS=8
export NCCL_SOCKET_IFNAME=ens30np0
export GLOO_SOCKET_IFNAME=ens30np0
export STEP5_MODEL_DIR="$MODEL_DIR"
export VLLM_USE_V2_MODEL_RUNNER=1
export VLLM_HCU_USE_CUSTOM_QUANTIZATION_GEMM=1
export VLLM_HCU_USE_FUSE_MOE_GATE=1
export VLLM_HCU_USE_FLASH_ATTN=1
export VLLM_HCU_USE_FLASH_ATTN_UNIFIED=1
export VLLM_USE_PD_SPLIT=1
export VLLM_HCU_USE_CUSTOM_OPS=1
export VLLM_HCU_USE_LIGHTOP_EP_SCATTER=1
export VLLM_HCU_USE_CUSTOM_SILU_AND_MUL=1
export VLLM_USE_FLASH_ATTN_FP8=1
export VLLM_HCU_USE_LIGHTOP_MOE_ALIGN=1
